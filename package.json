{
   "name": "scrypted-vivint",
   "version": "0.0.1",
   "description": "Vivint Camera Plugin for Scrypted (spike: fork of scryptedapp/blink, vivintpy-based)",
   "license": "Apache",
   "keywords": [
      "scrypted",
      "plugin",
      "vivint",
      "camera"
   ],
   "scripts": {
      "scrypted-setup-project": "scrypted-setup-project",
      "prescrypted-setup-project": "scrypted-package-json",
      "build": "scrypted-webpack",
      "prepublishOnly": "NODE_ENV=production scrypted-webpack",
      "prescrypted-vscode-launch": "scrypted-webpack",
      "scrypted-vscode-launch": "scrypted-deploy-debug",
      "scrypted-deploy-debug": "scrypted-deploy-debug",
      "scrypted-debug": "scrypted-debug",
      "scrypted-deploy": "scrypted-deploy",
      "scrypted-readme": "scrypted-readme",
      "scrypted-package-json": "scrypted-package-json"
   },
   "scrypted": {
      "name": "Vivint Camera Plugin",
      "runtime": "python",
      "type": "DeviceProvider",
      "interfaces": [
         "Settings",
         "DeviceProvider"
      ],
      "pluginDependencies": [
         "@scrypted/snapshot",
         "@scrypted/prebuffer-mixin"
      ]
   },
   "devDependencies": {
      "@scrypted/sdk": "^0.5.12"
   },
   "repository": {
      "type": "git",
      "url": "git+https://github.com/spacedouut/blink.git"
   },
   "bugs": {
      "url": "https://github.com/spacedouut/blink/issues"
   }
}